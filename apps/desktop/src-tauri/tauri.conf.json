{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recall",
  "version": "0.1.0",
  "identifier": "com.example.recall.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Recall", "width": 1100, "height": 780, "minWidth": 720, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:8000 http://127.0.0.1:8000"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/whisper-cli"],
    "resources": {
      "voice-assets/ggml-base.bin": "resources/models/ggml-base.bin",
      "voice-assets/whisper.dll": "",
      "voice-assets/ggml.dll": "",
      "voice-assets/ggml-cpu.dll": "",
      "voice-assets/ggml-base.dll": "",
      "voice-assets/WHISPER-LICENSE.txt": "resources/licenses/WHISPER-LICENSE.txt",
      "voice-assets/MODEL-CARD.txt": "resources/licenses/MODEL-CARD.txt"
    },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
