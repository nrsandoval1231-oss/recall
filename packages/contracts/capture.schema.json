{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recall capture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client_capture_id", "device_id", "captured_at", "timezone", "source_kind", "context_hint", "pages"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "client_capture_id": {"type": "string", "format": "uuid"},
    "device_id": {"type": "string", "format": "uuid"},
    "captured_at": {"type": "string", "format": "date-time"},
    "timezone": {"type": "string", "minLength": 1, "maxLength": 100},
    "source_kind": {"enum": ["handwritten_note", "photo_document"]},
    "context_hint": {"type": ["string", "null"], "maxLength": 2000},
    "pages": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["client_page_id", "ordinal", "media_type", "byte_size", "sha256", "original_filename"],
        "properties": {
          "client_page_id": {"type": "string", "format": "uuid"},
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 10},
          "media_type": {"enum": ["image/jpeg", "image/png", "image/heic", "image/heif"]},
          "byte_size": {"type": "integer", "minimum": 1, "maximum": 26214400},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "original_filename": {"type": ["string", "null"], "maxLength": 255}
        }
      }
    }
  }
}
