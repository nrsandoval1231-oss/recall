# Generate strong independent values. Never commit the populated .env file.
POSTGRES_USER=postgres
POSTGRES_DB=recall
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
MEGRAPH_OWNER_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
MEGRAPH_API_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
MEGRAPH_WORKER_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
DATABASE_URL=postgresql://recall_api:REPLACE_API_PASSWORD@db:5432/recall
RECALL_MIGRATION_DATABASE_URL=postgresql://recall_owner:REPLACE_OWNER_PASSWORD@db:5432/recall
RECALL_WORKER_DATABASE_URL=postgresql://recall_worker_login:REPLACE_WORKER_PASSWORD@db:5432/recall
RECALL_ENV=production
RECALL_AUTO_PROVISION_WORKSPACES=false
RECALL_AUTH_ISSUER=https://REPLACE_HOSTNAME
RECALL_AUTH_JWT_SECRET=REPLACE_WITH_INDEPENDENT_64_HEX_CHARACTERS
RECALL_SIGNING_SECRET=REPLACE_WITH_INDEPENDENT_64_HEX_CHARACTERS
RECALL_OPERATOR_TOKEN=REPLACE_WITH_INDEPENDENT_64_HEX_CHARACTERS
RECALL_SITE_ORIGINS=https://REPLACE_HOSTNAME
RECALL_STORAGE_BACKEND=local
RECALL_LOCAL_STORAGE_DIR=/app/storage
# Remote AI is off until these and explicit owner consent are configured.
# AI_PROVIDER=anthropic
# AI_MODEL_ID=<supported model>
# AI_API_KEY=<server-only secret>
# AI_INPUT_USD_PER_MTOK=<current published price>
# AI_OUTPUT_USD_PER_MTOK=<current published price>
# RECALL_AI_DAILY_BUDGET_USD=2
# RECALL_AI_MONTHLY_BUDGET_USD=20
