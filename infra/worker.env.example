# Copy to worker.env (ignored). Never use the table owner or a BYPASSRLS role.
MONOLITH_ENV=production
DATABASE_URL=
MONOLITH_WORKER_DATABASE_URL=
MONOLITH_AUTH_ISSUER=
MONOLITH_AUTH_JWKS_URL=
MONOLITH_SIGNING_SECRET=
MONOLITH_STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MONOLITH_STORAGE_BUCKET=recall-originals-private
AI_PROVIDER=anthropic
AI_MODEL_ID=
AI_API_KEY=
AI_EFFORT=high
AI_REFUSAL_FALLBACK=true
AI_INPUT_USD_PER_MTOK=
AI_OUTPUT_USD_PER_MTOK=
MONOLITH_AI_DAILY_BUDGET_USD=
MONOLITH_AI_MONTHLY_BUDGET_USD=

# Optional semantic retrieval. Supply reviewed current pricing and an explicit version.
# Install pgvector first; each workspace approves the combined AI policy in Settings.
# API and worker must use identical embedding configuration.
# MONOLITH_EMBEDDING_PROVIDER=voyage
# MONOLITH_EMBEDDING_MODEL_ID=
# MONOLITH_EMBEDDING_API_KEY=
# MONOLITH_EMBEDDING_DIMENSIONS=
# MONOLITH_EMBEDDING_VERSION=
# MONOLITH_EMBEDDING_INPUT_USD_PER_MTOK=
# MONOLITH_EMBEDDING_MAX_BATCH_TOKENS=4096
