{
  "name": "recall",
  "private": true,
  "version": "0.1.0",
  "description": "Recall monorepo (RCL-001: trusted capture)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/e2e/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9",
    "tsx": "^4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8",
    "vitest": "^5.0.3"
  }
}
