# Configuration inventory. Copy to an ignored .env during development. NEVER put real secrets here or in Git.
# Mobile/desktop bundles may only ever receive the PUBLIC values marked [client].

# ---------------- Backend (server only) -- services/backend ----------------
MONOLITH_ENV=development
# Non-owner login role that inherits recall_app. The API refuses to start if this role is a
# superuser, has BYPASSRLS, or owns the tables.
DATABASE_URL=
# Table-owner role, used ONLY by `python -m monolith.db.migrate` / `monolith.db.provision`.
MONOLITH_MIGRATION_DATABASE_URL=
# Token validation (Supabase Auth). Exactly one of JWKS URL (preferred) or legacy HS256 secret.
MONOLITH_AUTH_ISSUER=
MONOLITH_AUTH_AUDIENCE=authenticated
MONOLITH_AUTH_JWKS_URL=
MONOLITH_AUTH_JWT_SECRET=
# false = users need a pre-provisioned workspace (`python -m monolith.db.provision <user-id>`).
MONOLITH_AUTO_PROVISION_WORKSPACES=true
# >= 32 random chars. Signs upload capabilities and list cursors.
MONOLITH_SIGNING_SECRET=
# Explicit origins only (e.g. the Tauri desktop webview). Empty = no CORS.
MONOLITH_CORS_ORIGINS=
# Private object storage: "local" (dev/test) or "supabase".
MONOLITH_STORAGE_BACKEND=local
MONOLITH_LOCAL_STORAGE_DIR=.monolith-storage
SUPABASE_URL=
# Server-side only. Bypasses RLS/storage policy: never in a client bundle, log, or repository.
SUPABASE_SERVICE_ROLE_KEY=
MONOLITH_STORAGE_BUCKET=recall-originals-private
MONOLITH_MAX_PAGES_PER_CAPTURE=10
MONOLITH_MAX_PAGE_BYTES=26214400
MONOLITH_MAX_CAPTURE_BYTES=104857600
MONOLITH_UPLOAD_TOKEN_TTL_SECONDS=600

# ---------------- RCL-002 AI processing (server only) ----------------
# Nothing is sent to a provider unless ALL of these are set AND a workspace has turned AI reading on.
AI_PROVIDER=                 # "anthropic" (the only supported provider)
AI_MODEL_ID=                 # e.g. claude-opus-5-5 (configuration, never hard-coded)
AI_API_KEY=                  # secret; never in a client bundle, log, or repository
AI_EFFORT=high
AI_REFUSAL_FALLBACK=true
AI_INPUT_USD_PER_MTOK=       # current provider prices for AI_MODEL_ID; used for budget accounting
AI_OUTPUT_USD_PER_MTOK=
MONOLITH_AI_DAILY_BUDGET_USD=  # owner-approved spending limits; processing and answers stop when reached
MONOLITH_AI_MONTHLY_BUDGET_USD=
AI_IMAGE_MAX_EDGE=2000
# Pairing is inactive unless reviewed server activation is explicitly approved.
MONOLITH_DEVICE_PAIRING_ENABLED=false
MONOLITH_MAX_PROCESSING_ATTEMPTS=3
# Worker process (python -m monolith.ingestion.worker): a login role that inherits recall_worker.
MONOLITH_WORKER_DATABASE_URL=
MONOLITH_WORKER_LEASE_SECONDS=900

# ---------------- Optional RCL-003 semantic retrieval (server only) ----------------
# Uncomment and fill ALL fields together; requires pgvector and explicit workspace consent.
# MONOLITH_EMBEDDING_PROVIDER=voyage
# MONOLITH_EMBEDDING_MODEL_ID=
# MONOLITH_EMBEDDING_API_KEY=
# MONOLITH_EMBEDDING_DIMENSIONS=
# MONOLITH_EMBEDDING_VERSION=
# MONOLITH_EMBEDDING_INPUT_USD_PER_MTOK=
# MONOLITH_EMBEDDING_MAX_BATCH_TOKENS=4096

# ---------------- Mobile (Expo) -- apps/mobile/.env ----------------  [client]
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------- Desktop (Vite/Tauri) -- apps/desktop/.env ----------------  [client]
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
