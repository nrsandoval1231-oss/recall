# Configuration inventory. Copy to an ignored .env during development. NEVER put real secrets here or in Git.
# Mobile/desktop bundles may only ever receive the PUBLIC values marked [client].

# ---------------- Backend (server only) -- services/backend ----------------
RECALL_ENV=development
# Non-owner login role that inherits recall_app. The API refuses to start if this role is a
# superuser, has BYPASSRLS, or owns the tables.
DATABASE_URL=
# Table-owner role, used ONLY by `python -m recall.db.migrate` / `recall.db.provision`.
RECALL_MIGRATION_DATABASE_URL=
# Token validation (Supabase Auth). Exactly one of JWKS URL (preferred) or legacy HS256 secret.
RECALL_AUTH_ISSUER=
RECALL_AUTH_AUDIENCE=authenticated
RECALL_AUTH_JWKS_URL=
RECALL_AUTH_JWT_SECRET=
# false = users need a pre-provisioned workspace (`python -m recall.db.provision <user-id>`).
RECALL_AUTO_PROVISION_WORKSPACES=true
# >= 32 random chars. Signs upload capabilities and list cursors.
RECALL_SIGNING_SECRET=
# Explicit origins only (e.g. the Tauri desktop webview). Empty = no CORS.
RECALL_CORS_ORIGINS=
# Private object storage: "local" (dev/test) or "supabase".
RECALL_STORAGE_BACKEND=local
RECALL_LOCAL_STORAGE_DIR=.recall-storage
SUPABASE_URL=
# Server-side only. Bypasses RLS/storage policy: never in a client bundle, log, or repository.
SUPABASE_SERVICE_ROLE_KEY=
RECALL_STORAGE_BUCKET=recall-originals-private
RECALL_MAX_PAGES_PER_CAPTURE=10
RECALL_MAX_PAGE_BYTES=26214400
RECALL_MAX_CAPTURE_BYTES=104857600
RECALL_UPLOAD_TOKEN_TTL_SECONDS=600

# ---------------- RCL-002+ (not read by RCL-001) ----------------
AI_PROVIDER=
AI_MODEL_ID=
AI_API_KEY=
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSIONS=
RECALL_MAX_PROCESSING_ATTEMPTS=3
RECALL_AI_DAILY_BUDGET_USD=
RECALL_AI_MONTHLY_BUDGET_USD=

# ---------------- Mobile (Expo) -- apps/mobile/.env ----------------  [client]
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------- Desktop (Vite/Tauri) -- apps/desktop/.env ----------------  [client]
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
