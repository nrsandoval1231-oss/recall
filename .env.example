# Documentation-only configuration inventory. No runtime currently reads this file.
# Copy to an ignored .env only during implementation. Never put secrets in mobile/desktop bundles.
RECALL_ENV=development
RECALL_API_BASE_URL=http://localhost:8000

# Server only. Configure actual credentials in a secret manager, not Git.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RECALL_STORAGE_BUCKET=recall-originals-private
AI_PROVIDER=
AI_MODEL_ID=
AI_API_KEY=
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSIONS=

# Proposed operational defaults; the implemented configuration must validate them.
RECALL_MAX_PAGES_PER_CAPTURE=10
RECALL_MAX_PAGE_BYTES=26214400
RECALL_MAX_CAPTURE_BYTES=104857600
RECALL_MAX_PROCESSING_ATTEMPTS=3
RECALL_SOURCE_URL_TTL_SECONDS=60
# Production AI must remain disabled until owner-approved spending limits are configured.
RECALL_AI_DAILY_BUDGET_USD=
RECALL_AI_MONTHLY_BUDGET_USD=
